# Optional. `npm start` / `npm run setup` create .env for you; edit it only for special cases.
# MySQL server on this computer (the setup questions fill these in):
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your-mysql-password
# DB_NAME=cinecircle
# Connect through a Unix socket instead of host/port:
# DB_SOCKET=/path/to/mysql.sock
#
# To use the Docker database instead (`docker compose up -d --wait db`):
# DB_HOST=127.0.0.1
# DB_PORT=3307
# DB_USER=root
# DB_PASSWORD=cinecircle-root
#
# Website address and login sessions:
# HOST=127.0.0.1
# PORT=3001
# SESSION_SECRET=replace-with-a-long-random-value
