{
  "name": "cinecircle",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "setup": "node scripts/launch.mjs setup",
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "node --watch server/index.mjs",
    "build": "vite build",
    "start": "node scripts/launch.mjs start",
    "test": "node scripts/db.mjs check && node --test --test-concurrency=1 tests/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/baskervville": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@lucide/vue": "^1.72.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "mysql2": "^3.24.6",
    "vue": "^3.5.45",
    "vue-router": "^5.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "prettier": "^3.9.10",
    "supertest": "^7.3.2",
    "vite": "^8.3.8"
  }
